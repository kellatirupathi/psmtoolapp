# Copy this file to desktop.env (same folder) for desktop runtime overrides.
# You can also place desktop.env in %APPDATA%/PSM Analyser/ (userData path).

MONGODB_URL=
MONGODB_DB_NAME=psm_db_user
GSHEET_ID=

# Optional
OPENAI_API_KEY=
GEMINI_API_KEY=
