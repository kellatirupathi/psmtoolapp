GEMINI_TRANSCRIBE_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-flash
INTERVIEW_TRANSCRIPTION_PROVIDER=gemini
INTERVIEW_QNA_PROVIDER=gemini
GITHUB_GIST_TOKEN=
